.page {
  padding: 30rpx 26rpx 60rpx;
}

.hd {
  padding: 4rpx 0 18rpx;
}

.hd-top {
  display: flex;
  align-items: flex-start;
}

.h1 {
  flex: 1;
  font-size: 40rpx;
  font-size: calc(40rpx * var(--fs, 1));
  font-weight: 700;
  line-height: 1.32;
  letter-spacing: -0.5rpx;
}

.tier {
  flex: none;
  margin-left: 12rpx;
  margin-top: 6rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 19rpx;
  font-size: calc(19rpx * var(--fs, 1));
  font-weight: 600;
}

.tier.spit { background: #fbeee9; color: #8b4b3a; }
.tier.mid { background: #f0efe9; color: #5f5e5a; }
.tier.big { background: #e9f1fb; color: #185fa5; }
.tier.xl { background: #fbf1df; color: #a8781f; }
.tier.none { background: #f4f3ee; color: #a8a49a; }
.tier.contested { background: #f6f1e2; color: #8a6b1f; }
.tier.ended { background: #f4f3ee; color: #b4b0a6; }

.hd-tags {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.c-provider {
  color: #8a8a84;
  font-size: 21rpx;
  font-size: calc(21rpx * var(--fs, 1));
  margin-right: 12rpx;
}

.deliv {
  margin-right: 10rpx;
  padding: 1rpx 10rpx;
  border-radius: 5rpx;
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs, 1));
}

.deliv.api { background: #e9f1fb; color: #185fa5; }
.deliv.client { background: #f1ecf8; color: #5b3f8a; }
.deliv.web { background: #e8f4f1; color: #1f6b5e; }

.conf {
  padding: 1rpx 10rpx;
  border-radius: 5rpx;
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs, 1));
}

.conf.ok { background: #e8f4ef; color: #0f6e56; }
.conf.mid { background: #fbf1df; color: #8a5a12; }
.conf.bad { background: #fbeeee; color: #a32d2d; }

/* 伪免费 */
.paid {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 12rpx 16rpx;
  border: 2rpx solid #f3e2c7;
  border-radius: 12rpx;
  background: #fdf5ea;
}

.paid-tag {
  flex: none;
  margin-right: 12rpx;
  padding: 2rpx 10rpx;
  border-radius: 5rpx;
  background: #b8842a;
  color: #ffffff;
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs, 1));
  font-weight: 600;
}

.paid-note {
  color: #8a5a12;
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs, 1));
}

/* 内容块 */
.block {
  margin-bottom: 16rpx;
  padding: 24rpx 26rpx;
  border: 2rpx solid #e6e4dd;
  border-radius: 22rpx;
  background: #ffffff;
}

.block-lab {
  display: block;
  color: #a8a49a;
  font-size: 19rpx;
  font-size: calc(19rpx * var(--fs, 1));
  letter-spacing: 2rpx;
}

.block-txt {
  display: block;
  margin-top: 10rpx;
  color: #1c1c1a;
  font-size: 26rpx;
  font-size: calc(26rpx * var(--fs, 1));
  line-height: 1.6;
}

/* 信息行 */
.rows {
  margin-bottom: 16rpx;
  padding: 8rpx 26rpx;
  border: 2rpx solid #e6e4dd;
  border-radius: 22rpx;
  background: #ffffff;
}

.row {
  display: flex;
  align-items: baseline;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f4f3ee;
}

.row:last-child {
  border-bottom: none;
}

.row-k {
  width: 140rpx;
  flex: none;
  color: #a8a49a;
  font-size: 21rpx;
  font-size: calc(21rpx * var(--fs, 1));
}

.row-v-wrap {
  flex: 1;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.row-v {
  flex: 1;
  color: #3a3a36;
  font-size: 23rpx;
  font-size: calc(23rpx * var(--fs, 1));
  line-height: 1.55;
}

.gtag {
  flex: none;
  margin-right: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: 5rpx;
  background: #f4f3ee;
  color: #6d6a62;
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs, 1));
}

.dom {
  flex: none;
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: 5rpx;
  font-size: 17rpx;
  font-size: calc(17rpx * var(--fs, 1));
}

.dom.ok { background: #e8f4ef; color: #0f6e56; }
.dom.bad { background: #fbeeee; color: #a32d2d; }
.dom.mid { background: #fbf1df; color: #8a5a12; }

/* 入口 */
.entry {
  padding: 24rpx 26rpx;
  border: 2rpx solid #e6e4dd;
  border-radius: 22rpx;
  background: #ffffff;
}

.entry-lab {
  display: block;
  color: #a8a49a;
  font-size: 19rpx;
  font-size: calc(19rpx * var(--fs, 1));
  letter-spacing: 2rpx;
}

.entry-url {
  display: block;
  margin-top: 10rpx;
  color: #185fa5;
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs, 1));
  line-height: 1.6;
  word-break: break-all;
}

.entry-btn {
  margin-top: 18rpx;
  padding: 16rpx 0;
  border-radius: 14rpx;
  background: #1c1c1a;
  color: #ffffff;
  font-size: 24rpx;
  font-size: calc(24rpx * var(--fs, 1));
  text-align: center;
}

.note {
  margin-top: 22rpx;
  padding: 0 4rpx;
}

.note-t {
  color: #a8a49a;
  font-size: 19rpx;
  font-size: calc(19rpx * var(--fs, 1));
  line-height: 1.7;
}

.empty {
  display: block;
  padding: 120rpx 0;
  color: #a8a49a;
  font-size: 24rpx;
  font-size: calc(24rpx * var(--fs, 1));
  text-align: center;
}
